BRIEF_MINUTE=0
BRIEF_FRESH_HOURS=72
BRIEF_MAX_AGE_DAYS=7
BRIEF_MAX_ITEMS=5
SCHEDULER_ENABLED=true
COLLECTOR_LIMIT=12
NEWS_SOURCES=["reddit","openai_blog","anthropic_blog","google_deepmind_blog","cursor_blog","claude_code_blog","codex_blog","github_trending"]
REDDIT_MAX_AGE_HOURS=72
